{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "forex-terminal",
  "version": "0.1.0",
  "identifier": "com.forex.terminal",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Forex Terminal",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://tauri.localhost:* https://tauri.localhost:*; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "../bot/": "",
      "../shared/": "",
      "../mcp/": "",
      "../.opencode/": "",
      "../opencode.json": "opencode.json",
      "../AGENTS.md": "AGENTS.md"
    }
  }
}
