{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/grok-4.7",
  "mcp": {
    "market-data": {
      "type": "local",
      "command": ["python", "-u", "mcp/market_data.py"],
      "enabled": true,
      "environment": {}
    },
    "wafle-scraper": {
      "type": "local",
      "command": ["wafle-scraper"],
      "enabled": true,
      "environment": {}
    }
  },
  "agent": {
    "market-analyst": {
      "description": "Analyse le marche Forex via les APIs publiques (MCP market-data) et propose des parametres de bot en JSON strict. Ne trade jamais, n'ecrit aucun fichier.",
      "mode": "primary",
      "prompt": "{file:./AGENTS.md}",
      "tools": { "write": false, "edit": false, "bash": false }
    }
  },
  "permission": {
    "edit": { "**": "deny" },
    "bash": { "**": "deny" },
    "skill": { "*": "allow" }
  }
}
