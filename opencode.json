{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/grok-4.7",
  "mcp": {
    "market-data": {
      "type": "local",
      "command": ["python", "-u", "mcp/market_data.py"],
      "enabled": true,
      "environment": {}
    },
    "wafle-scraper": {
      "type": "local",
      "command": ["wafle-scraper"],
      "enabled": true,
      "environment": {}
    }
  },
  "agent": {
    "market-analyst": {
      "description": "Analyste de marche : analyse le marche Forex via les APIs publiques et propose la configuration du bot en JSON strict. Ne trade jamais et n'ecrit aucun fichier.",
      "mode": "primary",
      "prompt": "{file:./AGENTS.md}",
      "tools": { "write": false, "edit": false, "bash": false },
      "permission": {
        "edit": { "**": "deny" },
        "write": { "**": "deny" },
        "bash": { "**": "deny" }
      }
    },
    "dev-agent": {
      "description": "Developpeur : modifie le code de l'application, cree et corrige des strategies, lance les tests. A le droit d'ecrire des fichiers et d'executer des commandes.",
      "mode": "primary",
      "prompt": "{file:./DEVAGENTS.md}",
      "permission": {
        "edit": { "**": "allow" },
        "write": { "**": "allow" },
        "bash": { "*": "allow" }
      }
    }
  }
}
